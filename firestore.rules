rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedBootstrapAdmin() {
      return isSignedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email == 'hendry.njt@gmail.com';
    }

    function isAdmin() {
      return isVerifiedBootstrapAdmin()
        || (isSignedIn()
          && request.auth.token.email_verified == true
          && exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    function isValidMcqQuestion(q) {
      return q is map
        && q.keys().hasAll(['id', 'prompt', 'options', 'correctIndex'])
        && q.keys().hasOnly(['id', 'prompt', 'options', 'correctIndex'])
        && q.id is string && q.id.size() >= 1 && q.id.size() <= 40
        && q.prompt is string && q.prompt.size() >= 3 && q.prompt.size() <= 300
        && q.options is list && q.options.size() == 4
        && q.options[0] is string && q.options[0].size() >= 1 && q.options[0].size() <= 200
        && q.options[1] is string && q.options[1].size() >= 1 && q.options[1].size() <= 200
        && q.options[2] is string && q.options[2].size() >= 1 && q.options[2].size() <= 200
        && q.options[3] is string && q.options[3].size() >= 1 && q.options[3].size() <= 200
        && q.correctIndex is int && q.correctIndex >= 0 && q.correctIndex <= 3;
    }

    function isValidDailyAssessment(data) {
      return data.keys().hasAll([
          'activeDate', 'welcomeTitle', 'tagline', 'channelUrl',
          'youtubeShortsUrl', 'iqPromptIntro', 'iqPrompts',
          'questions', 'updatedBy', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'activeDate', 'welcomeTitle', 'tagline', 'channelUrl',
          'youtubeShortsUrl', 'iqPromptIntro', 'iqPrompts',
          'questions', 'updatedBy', 'updatedAt'
        ])
        && data.activeDate is string && data.activeDate.size() <= 20 && data.activeDate.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && data.welcomeTitle is string && data.welcomeTitle.size() >= 2 && data.welcomeTitle.size() <= 100
        && data.tagline is string && data.tagline.size() >= 2 && data.tagline.size() <= 100
        && data.channelUrl is string && data.channelUrl.size() >= 10 && data.channelUrl.size() <= 300
        && data.youtubeShortsUrl is string && data.youtubeShortsUrl.size() >= 10 && data.youtubeShortsUrl.size() <= 300
        && data.iqPromptIntro is string && data.iqPromptIntro.size() >= 10 && data.iqPromptIntro.size() <= 500
        && data.iqPrompts is list && data.iqPrompts.size() >= 1 && data.iqPrompts.size() <= 8
        && data.iqPrompts[0] is string && data.iqPrompts[0].size() >= 5 && data.iqPrompts[0].size() <= 240
        && data.questions is list && data.questions.size() == 4
        && isValidMcqQuestion(data.questions[0])
        && isValidMcqQuestion(data.questions[1])
        && isValidMcqQuestion(data.questions[2])
        && isValidMcqQuestion(data.questions[3])
        && data.updatedBy is string && data.updatedBy == request.auth.uid && data.updatedBy.size() <= 128
        && data.updatedAt == request.time;
    }

    function isValidCandidateSubmissionShape(data) {
      return data.keys().hasAll([
          'track', 'fullName', 'mobile', 'email', 'company', 'experienceYears',
          'mcqAnswers', 'mcqScore', 'iqQuestion', 'iqResponse', 'iqScore',
          'totalScore', 'subscribedConfirmed', 'assessmentDate', 'createdAt'
        ])
        && data.keys().hasOnly([
          'track', 'fullName', 'mobile', 'email', 'company', 'experienceYears',
          'mcqAnswers', 'mcqScore', 'iqQuestion', 'iqResponse', 'iqScore',
          'totalScore', 'subscribedConfirmed', 'assessmentDate', 'createdAt'
        ])
        && data.track is string && data.track in ['Fresher', 'Experienced']
        && data.fullName is string && data.fullName.size() >= 2 && data.fullName.size() <= 80
        && data.mobile is string && data.mobile.size() >= 8 && data.mobile.size() <= 20 && data.mobile.matches('^[0-9+\\-\\s]{8,20}$')
        && data.email is string && data.email.size() >= 5 && data.email.size() <= 120 && data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
        && data.company is string && data.company in ['Firstsource', 'Star Health Insurance', 'Frankfinn', 'Altruist']
        && data.experienceYears is string && data.experienceYears.size() <= 30
        && data.mcqAnswers is list && data.mcqAnswers.size() == 4
        && data.mcqAnswers[0] is int && data.mcqAnswers[0] >= 0 && data.mcqAnswers[0] <= 3
        && data.mcqAnswers[1] is int && data.mcqAnswers[1] >= 0 && data.mcqAnswers[1] <= 3
        && data.mcqAnswers[2] is int && data.mcqAnswers[2] >= 0 && data.mcqAnswers[2] <= 3
        && data.mcqAnswers[3] is int && data.mcqAnswers[3] >= 0 && data.mcqAnswers[3] <= 3
        && data.mcqScore is int && data.mcqScore in [0, 2, 4, 6, 8]
        && data.iqQuestion is string && data.iqQuestion.size() >= 5 && data.iqQuestion.size() <= 240
        && data.iqResponse is string && data.iqResponse.size() >= 5 && data.iqResponse.size() <= 1000
        && data.iqScore is int && data.iqScore in [0, 2]
        && data.totalScore is int && data.totalScore >= 0 && data.totalScore <= 10
        && data.totalScore == data.mcqScore + data.iqScore
        && data.subscribedConfirmed is bool
        && data.assessmentDate is string && data.assessmentDate.size() <= 20 && data.assessmentDate.matches('^\\d{4}-\\d{2}-\\d{2}$');
    }

    function isValidCandidateSubmissionCreate(data) {
      return isValidCandidateSubmissionShape(data) && data.createdAt == request.time;
    }

    function isValidCandidateSubmissionUpdate(data) {
      return isValidCandidateSubmissionShape(data)
        && data.createdAt == existing().createdAt
        && data.mcqScore == existing().mcqScore;
    }

    function isValidSubmissionLock(data) {
      return data.keys().hasAll(['assessmentDate', 'submitted', 'createdAt'])
        && data.keys().hasOnly(['assessmentDate', 'submitted', 'createdAt'])
        && data.assessmentDate is string && data.assessmentDate.size() <= 20 && data.assessmentDate.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && data.submitted == true
        && data.createdAt == request.time;
    }

    match /test/connection {
      allow get: if true;
    }

    match /admins/{uid} {
      allow get: if isSignedIn() && isValidId(uid) && (request.auth.uid == uid || isAdmin());
      allow list, create, update, delete: if false;
    }

    match /dailyAssessments/{assessmentId} {
      allow get: if isValidId(assessmentId) && assessmentId == 'current';
      allow list: if false;
      allow create: if isSignedIn()
        && isValidId(assessmentId)
        && assessmentId == 'current'
        && isValidDailyAssessment(incoming())
        && isAdmin();
      allow update: if isSignedIn()
        && isValidId(assessmentId)
        && assessmentId == 'current'
        && isValidDailyAssessment(incoming())
        && isAdmin()
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'activeDate', 'welcomeTitle', 'tagline', 'channelUrl',
          'youtubeShortsUrl', 'iqPromptIntro', 'iqPrompts',
          'questions', 'updatedBy', 'updatedAt'
        ]);
      allow delete: if false;
    }

    match /candidateSubmissions/{submissionId} {
      allow create: if isValidId(submissionId) && isValidCandidateSubmissionCreate(incoming());
      allow get: if isSignedIn() && isValidId(submissionId) && isAdmin();
      allow list: if isVerifiedBootstrapAdmin();
      allow update: if isSignedIn()
        && isValidId(submissionId)
        && isValidCandidateSubmissionUpdate(incoming())
        && isAdmin()
        && incoming().diff(existing()).affectedKeys().hasOnly(['iqScore', 'totalScore']);
      allow delete: if isSignedIn() && isValidId(submissionId) && isAdmin();
    }

    match /submissionLocks/{lockId} {
      allow get: if isValidId(lockId);
      allow list: if false;
      allow create: if isValidId(lockId) && isValidSubmissionLock(incoming());
      allow update: if false;
      allow delete: if isSignedIn() && isValidId(lockId) && isAdmin();
    }
  }
}
